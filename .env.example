# ---------------------------------------------------------------------------
# WEBORA environment configuration
# Copy to `.env.local` and fill in what you have. Everything is optional:
# WEBORA ships with a working local mode so the app runs with zero config.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign session cookies (required in production).
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- Storage mode ----------------------------------------------------------
# `local`  → file-backed JSON store (.data/webora.json) + local auth. Zero config.
# `supabase` → PostgreSQL via Supabase (see database/migrations).
STORAGE_DRIVER=local

# --- Supabase (optional, used when STORAGE_DRIVER=supabase) ----------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations (npm run db:migrate)
DATABASE_URL=

# --- AI provider (optional) ------------------------------------------------
# When empty, WEBORA uses the built-in deterministic generator engine and the
# UI labels output as "Local engine". When set, generations are streamed from
# the provider and labelled "AI provider". NEVER expose these to the browser.
AI_PROVIDER=            # openai | anthropic | gemini | openai-compatible
AI_API_KEY=
AI_MODEL=               # e.g. gpt-4o-mini / claude-3-5-sonnet / gemini-1.5-pro
AI_BASE_URL=            # required only for AI_PROVIDER=openai-compatible
AI_MAX_TOKENS=4096

# --- Payments (optional) ---------------------------------------------------
# Architecture only — no charge is ever attempted unless these are configured.
PAYMENTS_PROVIDER=      # razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Domains (optional) ----------------------------------------------------
# Custom-domain provisioning uses the Vercel Domains API.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# --- Analytics (optional) --------------------------------------------------
# When empty WEBORA records its own first-party page-view events.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# ── Email (optional) ───────────────────────────────────────────────────────────
# Leave empty to show password-reset links in-app instead of pretending to send mail.
EMAIL_PROVIDER=

# ── Self-hosting ingress (optional) ────────────────────────────────────────────
# Used when building the DNS instructions shown for custom domains.
WEBORA_INGRESS_IP=
WEBORA_INGRESS_TARGET=
